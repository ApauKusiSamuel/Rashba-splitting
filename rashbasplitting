<script>

/* ==========================================================
   STEP NAVIGATION
========================================================== */

const steps = document.querySelectorAll(".step");

let currentStep = 0;

const counter = document.getElementById("counter");
const prevBtn = document.getElementById("prevBtn");
const nextBtn = document.getElementById("nextBtn");

function showStep(index) {

    if (index < 0) {
        index = 0;
    }

    if (index >= steps.length) {
        index = steps.length - 1;
    }

    currentStep = index;

    steps.forEach((step, i) => {

        step.classList.toggle(
            "active",
            i === currentStep
        );

    });

    counter.textContent =
        `${currentStep + 1} / ${steps.length}`;

    prevBtn.disabled =
        currentStep === 0;

    if (currentStep === steps.length - 1) {

        nextBtn.textContent = "Restart ↻";

    } else {

        nextBtn.textContent = "Next →";

    }

}

function nextStep() {

    if (currentStep === steps.length - 1) {

        showStep(0);

    } else {

        showStep(currentStep + 1);

    }

}

function previousStep() {

    showStep(currentStep - 1);

}


/* ==========================================================
   KEYBOARD NAVIGATION
========================================================== */

document.addEventListener("keydown", function(event) {

    if (event.key === "ArrowRight" ||
        event.key === " ") {

        event.preventDefault();
        nextStep();

    }

    if (event.key === "ArrowLeft") {

        event.preventDefault();
        previousStep();

    }

});


/* ==========================================================
   RASHBA BAND INTERACTION
========================================================== */

function setBandMode(mode) {

    const single =
        document.getElementById("singleBand");

    const upper =
        document.getElementById("upperBand");

    const lower =
        document.getElementById("lowerBand");

    const offButton =
        document.getElementById("socOff");

    const onButton =
        document.getElementById("socOn");

    if (mode === "off") {

        single.style.opacity = "1";

        upper.style.opacity = "0";

        lower.style.opacity = "0";

        offButton.classList.add("active");

        onButton.classList.remove("active");

    }

    if (mode === "on") {

        single.style.opacity = "0";

        upper.style.opacity = "1";

        lower.style.opacity = "1";

        offButton.classList.remove("active");

        onButton.classList.add("active");

    }

}


/* ==========================================================
   INITIALIZE
========================================================== */

showStep(0);

</script>

